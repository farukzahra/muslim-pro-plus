*.pyc
*.png
# Assets de loja versionados (ícone, feature graphic, screenshots)
!docs/store/**/*.png
# Camadas PNG do icone adaptativo (geradas por tools/generate_icon.py)
!app/src/main/res/drawable-xxxhdpi/*.png
# Prints próprios usados nos recaps de sessão
!docs/session-recaps/**/*.png
# Bandeiras do catálogo de adhan (flagcdn, domínio público)
!docs/adhan-preview/flags/*.png
!app/src/main/res/drawable-nodpi/*.png
# Arte e print-fonte do Instagram
!docs/instagram/**/*.png

# Sistema
Thumbs.db
.DS_Store

# Perfis de Chrome CDP usados por automacoes locais
.chrome-cdp-profile*/
